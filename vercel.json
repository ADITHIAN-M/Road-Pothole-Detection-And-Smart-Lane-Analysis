{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://road-pothole-detection-and-smart-lane.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}